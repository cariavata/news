# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# =================================================================
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# =================================================================
# Replace with your MongoDB Atlas Connection String.
# Example: mongodb+sandbox:username:password@cluster0.abcde.mongodb.net/dailypulse?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.mongodb.net/dailypulse?retryWrites=true&w=majority"

# =================================================================
# 2. EXTERNAL IMAGE STORAGE CONFIGURATION (Google Cloud Storage)
# =================================================================
# Google Cloud Storage Bucket Name
GCS_BUCKET_NAME="my-daily-pulse-storage"

# Google Cloud Project ID
GCS_PROJECT_ID="my-gcp-project-id"

# Path to Service Account JSON Key file (Optional if GCS_CREDENTIALS_JSON is provided)
GCS_KEYFILE_PATH=""

# Service Account Credentials JSON String (Optional, useful for Environment variables)
# Example: {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
GCS_CREDENTIALS_JSON=""
